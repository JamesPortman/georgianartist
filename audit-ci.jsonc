{
  // CI's dependency audit (`npx audit-ci --config audit-ci.jsonc`, first step of
  // .github/workflows/e2e.yml). Production dependencies only, failing on any
  // high or critical advisory.
  //
  // No exceptions. Until November 2026 two advisories in the Prisma CLI's
  // build-time dependencies (deepmerge-ts, mysql2) were allowlisted here; Prisma
  // 7.10.1 dropped both. If an exception is ever needed again, pin it to its
  // path ("GHSA-…|pkg>dep") so the same advisory arriving through anything else
  // still fails, and remove it once a release fixes it: audit-ci warns about
  // entries that no longer match (`show-not-found`). Never accept an
  // `npm audit fix` that "resolves" a finding by downgrading a major.
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "skip-dev": true,
  "show-not-found": true,
  "report-type": "summary",
  "allowlist": []
}
