# ─────────────────────────────────────────────────────────────────────────────
# Local development setup
#
# 1. Copy this file:
#      cp .env.local.example .env.local
# 2. Fill in real values below.
# 3. Restart `npm run dev` — Next.js only reads env files at startup.
#
# Shortcut: `vercel env pull .env.local` will populate any var marked
# "Development" in the Vercel dashboard. Vars set ONLY in Production scope
# (typically DATABASE_URL, SESSION_SECRET, ADMIN_PASSWORD) won't come down —
# you still have to add those by hand, OR add them to the Development scope
# in Vercel → Settings → Environment Variables so future pulls Just Work.
#
# Precedence: .env.local > .env (Next.js's normal rules). prisma.config.ts
# now respects this too, so the Prisma CLI matches the running app.
# ─────────────────────────────────────────────────────────────────────────────

# Neon (PostgreSQL) — a DEV BRANCH, never production.
# console.neon.tech → your project → Branches → Create branch (e.g. "dev"),
# then Connection Details for that branch. Use the POOLED connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# lib/db-guard.ts refuses any remote database whose host isn't named here
# (off Vercel). Paste the host part of the DATABASE_URL above, e.g.
# ep-dev-branch-123-pooler.us-east-2.aws.neon.tech. Don't put production's
# host here; for a deliberate production run, set it inline on that one command.
DATABASE_ALLOW_HOST="host"

# Admin panel — choose any password for local. Production uses Vercel's value.
ADMIN_PASSWORD="your-admin-password-here"

# Session encryption key — must be at least 32 characters.
# Local-only; does NOT need to match prod (each environment encrypts its own
# cookies). Generate a fresh one with:
#   openssl rand -hex 32
SESSION_SECRET="generate-a-32-char-random-string-here"

# Second, PRIVATE Blob store (Vercel → Storage → Create → Blob, access Private,
# connect to this project with the prefix PRIVATE_BLOB). Holds backups,
# unpublished uploads and collectors' photos (lib/private-blob.ts). Optional:
# without it uploads and backups use the public store as before.
# PRIVATE_BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Resend email API (already configured)
RESEND_API_KEY="re_..."

# ── Instagram automation ──────────────────────────────────────────────────────
# Claude API — for AI-generated captions (get from console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."

# Meta Graph API — for publishing to Instagram
# 1. Create a Meta app at developers.facebook.com
# 2. Add "Instagram Graph API" product
# 3. Generate a long-lived Page access token with these permissions:
#    instagram_basic, instagram_content_publish, pages_read_engagement
IG_ACCESS_TOKEN="your-long-lived-meta-access-token"
IG_BUSINESS_ACCOUNT_ID="your-instagram-business-account-id"

# Cron auth — already used by the backup cron; same secret covers Instagram cron
# CRON_SECRET="already-set-above-if-you-use-the-backup-cron"
