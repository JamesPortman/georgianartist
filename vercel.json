{
  "git": {
    "deploymentEnabled": {
      "dependabot/*": false
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ] || [ \"$ENABLE_PREVIEWS\" = \"1\" ]; then exit 1; else exit 0; fi",
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/instagram",
      "schedule": "0 15 * * 1,3,5"
    },
    {
      "path": "/api/cron/prune-analytics",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/health",
      "schedule": "0 * * * *"
    }
  ]
}
